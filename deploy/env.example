# 复制为 /etc/investment-dashboard.env，权限 600，属主 root：
#   sudo install -m 600 -o root deploy/env.example /etc/investment-dashboard.env
# 然后把下面两项改成自己的值。

# 资料目录（数据库、登录资料、加密密钥都在这里），需要 investment 用户可读写。
INVESTMENT_DATA_DIR=/var/lib/investment-dashboard

# 交易所 API 密钥的加密口令，至少 24 个字符。生成：openssl rand -base64 32
# 丢失它就无法解密已保存的密钥（重新填写密钥即可，不影响其他资料）；不要把它放进资料目录或备份。
INVESTMENT_MASTER_KEY=
